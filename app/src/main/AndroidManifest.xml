<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- RetroAchievements API (game identification, login, unlocks). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reads ROMs from the SD card ES-DE ROMs folder (read only) and keeps battery saves in DualPlay/saves, where DualDex reads them. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.DualPlay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize|density|mcc|mnc|locale|layoutDirection|fontScale|touchscreen|colorMode|fontWeightAdjustment|grammaticalGender|assetsPaths"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported for app-owned test launches (am start with extras). -->
        <activity
            android:name=".GameActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize|density|mcc|mnc|locale|layoutDirection|fontScale|touchscreen|colorMode|fontWeightAdjustment|grammaticalGender|assetsPaths"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape" />
    </application>
</manifest>
